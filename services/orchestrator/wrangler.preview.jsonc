{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-v5-worker-preview",
  "account_id": "4b35e17c8966dc88f57aa8019ebae2bb",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "vars": {
    "ENVIRONMENT": "preview",
    "HERMES_READ_ONLY": "true",
    "HERMES_OWNER_ALLOWLIST": "hermes_commander"
  },
  "kv_namespaces": [
    {
      "binding": "HERMES_LEDGER",
      "id": "REPLACE_WITH_PREVIEW_LEDGER_KV_ID"
    },
    {
      "binding": "IDEMPOTENCY_CACHE",
      "id": "REPLACE_WITH_PREVIEW_IDEMPOTENCY_KV_ID"
    }
  ]
}
