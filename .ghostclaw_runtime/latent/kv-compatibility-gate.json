{
  "schema": "ghostclaw.latentmas.kv_compatibility_gate.v1",
  "required_fields": [
    "model_id",
    "model_revision",
    "tokenizer_hash",
    "config_hash",
    "num_layers",
    "hidden_size",
    "num_attention_heads",
    "num_key_value_heads",
    "rope_scaling",
    "dtype",
    "quantization_mode",
    "cache_schema_hash"
  ],
  "compatibility_rule": "all_12_fields_must_match_exactly",
  "kv_required_field_count": 12,
  "exact_kv_compatibility_gate": true,
  "backend_requirement": "past_key_values",
  "on_mismatch": {
    "action": "fallback_to_json_text_brainstorm",
    "log": "kv_mismatch",
    "latent_bonus": 0
  },
  "kv_only_protocol": false,
  "kv_only_protocol_allowed": false,
  "decode_from_kv": false,
  "debug_probe_mode": "parallel_text_probe",
  "debug_probe_uses_decode_from_kv": false,
  "model_download_allowed": false,
  "gpu_live_inference_allowed": false
}
