{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GHOSTCLAW A2A Worker Receipt Template",
  "description": "Template for worker action receipts in the GHOSTCLAW A2A2A protocol. Every worker action must produce a receipt with autonomous mutual approval evidence.",
  "type": "object",
  "required": ["receipt_id", "task_id", "worker_id", "action", "timestamp", "self_approval_allowed"],
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Unique receipt identifier"
    },
    "task_id": {
      "type": "string",
      "description": "Task associated with this receipt"
    },
    "correlation_id": {
      "type": "string",
      "description": "Correlation ID for cross-worker tracing"
    },
    "decision_id": {
      "type": "string",
      "description": "Decision artifact identifier if applicable"
    },
    "brainstorm_id": {
      "type": "string",
      "description": "Canonical brainstorm session identifier if applicable"
    },
    "worker_id": {
      "type": "string",
      "description": "Worker that performed the action"
    },
    "from_agent": {
      "type": "string",
      "description": "Agent that emitted the receipt"
    },
    "to_agent": {
      "type": "string",
      "description": "Agent or orchestrator that should receive the receipt"
    },
    "action": {
      "type": "string",
      "description": "Action that was performed"
    },
    "action_class": {
      "type": "string",
      "description": "Class of action"
    },
    "requester_agent": {
      "type": "string",
      "description": "Agent that requested the action"
    },
    "approver_agent": {
      "type": "string",
      "description": "Agent that approved the action (must differ from requester_agent)"
    },
    "self_approval_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Must always be false per GHOSTCLAW autonomous mutual approval policy"
    },
    "payload": {
      "type": "object",
      "description": "Input payload for the action"
    },
    "output": {
      "type": "object",
      "description": "Output produced by the action"
    },
    "evidence_pack": {
      "type": "object",
      "description": "Evidence pack containing proof of work",
      "properties": {
        "artifacts": { "type": "array", "items": { "type": "object" } },
        "verification_data": { "type": "object" },
        "hash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "phase": {
      "type": "string",
      "enum": ["planning", "execution", "validation", "approval", "receipt", "finalization"]
    },
    "human_approval_required": {
      "type": "boolean",
      "default": false
    },
    "receipt_required": {
      "type": "boolean",
      "default": true
    },
    "control_plane_required": {
      "type": "boolean",
      "default": false
    },
    "latent_plane": {
      "type": "boolean",
      "default": false
    },
    "moa_summary": {
      "type": "string",
      "description": "Mixture-of-Agents summary if applicable"
    },
    "moa_gated_brainstorm": {
      "type": "object",
      "description": "MoA-gated brainstorm session (canonical: brainstorm)",
      "properties": {
        "brainstorm_id": { "type": "string" },
        "gated": { "type": "boolean" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "browser_use": {
      "type": "object",
      "description": "Browser automation metadata if applicable",
      "properties": {
        "url": { "type": "string" },
        "action": { "type": "string" },
        "result": { "type": "object" }
      }
    },
    "edgeone": {
      "type": "object",
      "description": "EdgeOne readiness metadata if applicable",
      "properties": {
        "target_environment": { "type": "string" },
        "ready": { "type": "boolean" },
        "checklist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "model_swap": {
      "type": "object",
      "description": "Model swap metadata if applicable",
      "properties": {
        "worker_id": { "type": "string" },
        "previous_model": { "type": "string" },
        "current_model": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 hash of receipt content for tamper detection"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the receipt"
    },
    "canonical_terminology": {
      "type": "object",
      "description": "Canonical terminology declaration",
      "properties": {
        "brainstorm": { "type": "string" },
        "beststorm": { "type": "string" },
        "beststrom": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
