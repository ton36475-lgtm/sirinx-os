# Example only. Do not rename to wrangler.toml or deploy without approval.
name = "sirinx-edge-agent-team-dev"
main = "src/index.ts"
compatibility_date = "2026-05-30"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true

[vars]
ENVIRONMENT = "dev"
PUBLIC_BASE_URL = "https://agents.sirinx.co"

# Do not store sensitive values in [vars].
# Future deployed Workers must use Wrangler secrets or Secrets Store.

[[durable_objects.bindings]]
name = "EDGE_ORCHESTRATOR"
class_name = "EdgeOrchestratorAgent"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["EdgeOrchestratorAgent"]

# Future bindings are draft-only:
# [[d1_databases]]
# binding = "SIRINX_AGENT_DB"
# database_name = "sirinx-agent-team-dev"
# database_id = "replace-after-approval"
#
# [[r2_buckets]]
# binding = "SIRINX_EVIDENCE_BUCKET"
# bucket_name = "sirinx-evidence-dev"
#
# [[queues.producers]]
# binding = "AGENT_JOBS"
# queue = "sirinx-agent-jobs-dev"
