{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sirinx-edge-agent-team-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "dev",
    "PUBLIC_BASE_URL": "https://agents.sirinx.co"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EDGE_ORCHESTRATOR",
        "class_name": "EdgeOrchestratorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EdgeOrchestratorAgent"]
    }
  ],
  "d1_databases": [
    {
      "binding": "SIRINX_AGENT_DB",
      "database_name": "sirinx-agent-team-dev",
      "database_id": "replace-after-approval"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SIRINX_EVIDENCE_BUCKET",
      "bucket_name": "sirinx-evidence-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_JOBS",
        "queue": "sirinx-agent-jobs-dev"
      }
    ],
    "consumers": [
      {
        "queue": "sirinx-agent-jobs-dev",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "sirinx-agent-jobs-dlq-dev"
      }
    ]
  }
}
