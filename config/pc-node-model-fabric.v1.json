{
  "schemaVersion": "sirinx.pc-node-model-fabric/v1",
  "snapshotDate": "2026-09-02",
  "releaseState": "HOLD_LOCAL_ONLY",
  "truthState": "REGISTRY_ONLY_DISABLED",
  "node": {
    "id": "pc-node",
    "platform": "windows",
    "role": "governed-compute-worker",
    "authority": "worker-only",
    "controlPlane": "mac-mini-hermes-commander",
    "requiresHardwareBoundPairing": true,
    "requiresSignedHeartbeat": true
  },
  "invariants": {
    "exactlyOneRetryOwnerPerRequest": true,
    "modelAliasesOnlyInClients": true,
    "runtimeClaimsRequireEvidence": true,
    "freeQuotaCountsAsSla": false,
    "secretValuesInRepository": false,
    "automaticBrowserAuthentication": false,
    "consequentialActionsRequireActionBoundApproval": true,
    "memoryNeverOutranksRuntimeEvidence": true,
    "oneWriterPerLeasedPath": true
  },
  "dataClasses": [
    "public",
    "internal",
    "sensitive",
    "restricted"
  ],
  "lanes": [
    {
      "id": "local-developer",
      "owner": "OMNIROUTE",
      "endpointRef": "http://127.0.0.1:20128/v1",
      "networkScope": "loopback",
      "ownsRetries": true,
      "maxRetryOwners": 1,
      "downstreamRoutersAllowFallbacks": false,
      "allowedDataClasses": [
        "public",
        "internal",
        "sensitive"
      ],
      "state": "UNVERIFIED"
    },
    {
      "id": "cloud-governed",
      "owner": "LITELLM",
      "endpointRef": "http://127.0.0.1:4000/v1",
      "networkScope": "loopback-gateway",
      "ownsRetries": true,
      "maxRetryOwners": 1,
      "downstreamRoutersAllowFallbacks": false,
      "allowedDataClasses": [
        "public",
        "internal"
      ],
      "state": "UNVERIFIED"
    },
    {
      "id": "emergency-broker",
      "owner": "OPENROUTER",
      "endpointRef": "env:OPENROUTER_BASE_URL",
      "networkScope": "remote",
      "ownsRetries": true,
      "maxRetryOwners": 1,
      "downstreamRoutersAllowFallbacks": true,
      "nestedBehindAnotherRouter": false,
      "defaultProviderPolicy": {
        "allowFallbacks": true,
        "requireParameters": true,
        "dataCollection": "deny",
        "zdr": true
      },
      "allowedDataClasses": [
        "public"
      ],
      "state": "UNCONFIGURED"
    },
    {
      "id": "direct-local",
      "owner": "DIRECT_CLIENT",
      "endpointRef": "env:SIRINX_LOCAL_OPENAI_BASE_URL",
      "networkScope": "loopback-or-private-lan",
      "ownsRetries": true,
      "maxRetryOwners": 1,
      "maxRetries": 0,
      "downstreamRoutersAllowFallbacks": false,
      "allowedDataClasses": [
        "public",
        "internal",
        "sensitive"
      ],
      "state": "UNVERIFIED"
    }
  ],
  "forbiddenChains": [
    [
      "OMNIROUTE",
      "LITELLM"
    ],
