# ── Build artifacts ─────────────────────────────────────────────────
**/target/
**/node_modules/
**/dist/
**/build/
**/.turbo/
**/.next/
**/.cache/
**/.gradle/
**/.pnpm-store/
**/.vite/
**/.vitest/
**/playwright-report/
**/.nyc_output/
**/coverage/

# ── Rust ────────────────────────────────────────────────────────────
**/*.rlib
**/*.d
**/Cargo.lock

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
**/*.swp
**/*.swo
**/*~
.vscode/
.idea/

# ── Runtime state (don't track live runtime state) ──────────────────
.ghostclaw_runtime/
.omnigent/
.thclaws/
.vibe-coding/
__pycache__/
**/__pycache__/
*.pyc

# ── Env / secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Logs ────────────────────────────────────────────────────────────
*.log
**/logs/

# ── Worktrees (do not nest) ─────────────────────────────────────────
.worktrees/

# ── Large generated content ─────────────────────────────────────────
**/workerd
**/*.bin
data/large/
