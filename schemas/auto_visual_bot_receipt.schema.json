{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/auto_visual_bot_receipt.schema.json",
  "title": "GhostClaw Auto Visual Bot Receipt",
  "type": "object",
  "required": [
    "packet_id",
    "run_id",
    "run_at",
    "routes_checked",
    "visual_diff_results",
    "a11y_violations",
    "broken_links",
    "console_errors",
    "overlap_findings",
    "lighthouse_scores",
    "seo_findings",
    "form_dry_run_result",
    "cross_browser_results",
    "verdict",
    "blocked_actions_confirmed",
    "no_deploy",
    "no_push",
    "no_cloud_mutation",
    "no_live_send",
    "no_secret_read"
  ],
  "properties": {
    "packet_id": { "type": "string", "const": "P087B_AUTO_VISUAL_BOT_CHECK_LAYER" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_at": { "type": "string", "minLength": 1 },
    "routes_checked": { "type": "array", "items": { "type": "string" } },
    "visual_diff_results": { "type": "array" },
    "a11y_violations": { "type": "array" },
    "broken_links": { "type": "array" },
    "console_errors": { "type": "array" },
    "overlap_findings": { "type": "array" },
    "lighthouse_scores": { "type": "object" },
    "seo_findings": { "type": "array" },
    "form_dry_run_result": { "type": "object" },
    "cross_browser_results": { "type": "array" },
    "verdict": {
      "type": "string",
      "enum": ["auto_review_pass_bot_verified", "auto_review_blocked_findings_attached"]
    },
    "blocked_actions_confirmed": { "type": "array", "items": { "type": "string" } },
    "no_deploy": { "const": true },
    "no_push": { "const": true },
    "no_cloud_mutation": { "const": true },
    "no_live_send": { "const": true },
    "no_secret_read": { "const": true }
  },
  "additionalProperties": true
}
