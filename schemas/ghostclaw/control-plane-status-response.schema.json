{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/ghostclaw/control-plane-status-response.schema.json",
  "title": "GhostClaw Control Plane Status Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "status",
    "mode",
    "dry_run",
    "live_execution",
    "projects",
    "missions",
    "packets",
    "approval_gates",
    "receipts",
    "dashboard",
    "guardrails",
    "updated_at"
  ],
  "properties": {
    "contract_id": {
      "const": "ghostclaw-control-plane-status-v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "needs_review",
        "blocked"
      ]
    },
    "mode": {
      "const": "read_only_control_plane_status"
    },
    "dry_run": {
      "const": true
    },
    "live_execution": {
      "const": false
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packet"
      }
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval_gate"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard"
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "slug",
        "focus_state",
        "status"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "focus_state": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "support",
            "archived"
          ]
        },
        "status": {
          "type": "string"
        },
        "public_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "private_domain": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "project_slug",
        "title",
        "action_tier",
        "status",
        "priority",
        "correlation_id"
      ],
      "properties": {
        "mission_id": {
          "type": "string"
        },
        "project_slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "action_tier": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "mission_id",
        "lane",
        "status",
        "dry_run",
        "live_execution",
        "next_action"
      ],
      "properties": {
        "packet_id": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "dry_run": {
          "const": true
        },
        "live_execution": {
          "const": false
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_code",
        "mission_id",
        "action_type",
        "status",
        "risk_level"
      ],
      "properties": {
        "gate_code": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "blocked",
            "not_required"
          ]
        },
        "risk_level": {
          "type": "string"
        },
        "rollback_plan_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "status",
        "artifact_path",
        "artifact_sha256",
        "redaction_status"
      ],
      "properties": {
        "receipt_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string"
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_status": {
          "type": "string"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_project_count",
        "active_mission_count",
        "pending_approval_count",
        "active_packet_id",
        "next_safe_action",
        "warnings"
      ],
      "properties": {
        "active_project_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_mission_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_approval_count": {
          "type": "integer",
          "minimum": 0
        },
        "active_packet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_safe_action": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "worker_execution",
        "live_telegram_send",
        "provider_call",
        "secret_read",
        "install",
        "push",
        "deploy",
        "cloudflare_r2_mutation",
        "database_migration"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "worker_execution": {
          "const": false
        },
        "live_telegram_send": {
          "const": false
        },
        "provider_call": {
          "const": false
        },
        "secret_read": {
          "const": false
        },
        "install": {
          "const": false
        },
        "push": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "cloudflare_r2_mutation": {
          "const": false
        },
        "database_migration": {
          "const": false
        }
      }
    }
  }
}
