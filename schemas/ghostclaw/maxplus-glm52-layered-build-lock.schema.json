{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/ghostclaw/maxplus-glm52-layered-build-lock.schema.json",
  "title": "GhostClaw MaxPlus GLM-5.2 Layered Build Lock",
  "description": "Domain schema for the local-safe MaxPlus GLM-5.2 harness and strict backend/API/frontend layered build sequence. This schema does not authorize provider calls, push, deploy, installs, migrations, model downloads, GPU-heavy jobs, or secret access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission",
    "harness",
    "layers",
    "lanes",
    "safety_policy"
  ],
  "properties": {
    "mission": {
      "$ref": "#/$defs/mission"
    },
    "harness": {
      "$ref": "#/$defs/harness"
    },
    "layers": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "file_leases": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/file_lease"
      }
    },
    "reviews": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/review_ref"
      }
    },
    "receipts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/receipt_ref"
      }
    },
    "safety_policy": {
      "$ref": "#/$defs/safety_policy"
    }
  },
  "$defs": {
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_name",
        "repo_root",
        "expected_branch",
        "mode",
        "source_of_truth"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "const": "GC-MAXPLUS-GLM52-LAYERED-LOCK-20260630-001"
        },
        "mission_name": {
          "type": "string",
          "const": "MAXPLUS_GLM52_SAFE_HARNESS_LAYERED_BUILD_LOCK_V8"
        },
        "repo_root": {
          "type": "string",
          "const": "/Users/sirinx/sirinx-os"
        },
        "expected_branch": {
          "type": "string",
          "const": "staging/godmode-master-os-v2"
        },
        "mode": {
          "type": "string",
          "const": "full_auto_safe_local_layered_sequence"
        },
        "source_of_truth": {
          "type": "string",
          "const": "local_repo"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_provider",
        "expected_model",
        "expected_identity",
        "effort_cap",
        "truth_sources",
        "provider_call_required_for_local_validation"
      ],
      "properties": {
        "expected_provider": {
          "type": "string",
          "const": "maxplus"
        },
        "expected_model": {
          "type": "string",
          "const": "glm-5.2"
        },
        "expected_identity": {
          "type": "string",
          "const": "glm-5.2 via MaxPlus proxy; not native Claude"
        },
        "effort_cap": {
          "type": "string",
          "const": "high"
        },
        "truth_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              ".claude/settings.local.json",
              "launcher environment",
              ".ghostclaw_runtime/receipts/*.json",
              "canary output"
            ]
          }
        },
        "provider_call_required_for_local_validation": {
          "type": "boolean",
          "const": false
        },
        "model_self_description_is_evidence": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_name",
        "role",
        "mutation_allowed",
        "status"
      ],
      "properties": {
        "lane_name": {
          "type": "string",
          "enum": [
            "Hermes_Commander",
            "Codex_Builder",
            "OpenCode_Reviewer",
            "GLM52_ClaudeCode_Lane",
            "Stagehand_UAT_Worker",
            "Validator_Worker"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "mutation_allowed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "write_scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "phase",
        "layer",
        "status",
        "allowed_groups",
        "receipt_required",
        "validation_required"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "pattern": "^P[0-9]{2}-[a-z0-9-]+$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "PHASE_0_OBSERVE_AND_FREEZE",
            "PHASE_1_BUILD_MAXPLUS_GLM52_SAFE_HARNESS",
            "PHASE_2_BACKEND_DOMAIN_SCHEMA",
            "PHASE_3_BACKEND_SERVICE_LOGIC",
            "PHASE_4_API_CONTRACT_FREEZE",
            "PHASE_5_API_ROUTE_HANDLER",
            "PHASE_6_API_CLIENT_WIRING",
            "PHASE_7_FRONTEND_STATE_HOOKS",
            "PHASE_8_FRONTEND_COMPONENTS",
            "PHASE_9_FRONTEND_PAGES_ONE_BY_ONE",
            "PHASE_10_LOCAL_UAT",
            "PHASE_11_REVIEW_AND_VALIDATION",
            "PHASE_12_LOCAL_COMMIT_GATE"
          ]
        },
        "layer": {
          "type": "string",
          "enum": [
            "observe_freeze",
            "harness",
            "backend_domain_schema",
            "backend_service_logic",
            "api_contract",
            "api_route_handler",
            "api_client",
            "frontend_state_hooks",
            "frontend_components",
            "frontend_pages",
            "local_uat",
            "review_validation",
            "local_commit_gate"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "queued",
            "leased",
            "building",
            "validation_pending",
            "receipt_written",
            "ready_for_review",
            "review_warn",
            "review_pass",
            "done",
            "blocked_until_previous_layer_done",
            "blocked_until_review",
            "blocked_until_all_validation_and_receipts"
          ]
        },
        "allowed_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden_groups": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "page_lock_required": {
          "type": "boolean",
          "default": false
        },
        "one_page_at_a_time": {
          "type": "boolean",
          "default": false
        },
        "receipt_required": {
          "type": "boolean",
          "const": true
        },
        "validation_required": {
          "type": "boolean",
          "const": true
        },
        "next_layer_opened": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "file_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "packet_id",
        "layer",
        "owner",
        "leased_files",
        "created_at",
        "status"
      ],
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_id": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "leased_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "leased",
            "released",
            "conflict",
            "expired"
          ]
        }
      }
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "path",
        "status"
      ],
      "properties": {
        "packet_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "written",
            "validated",
            "review_pending",
            "blocked"
          ]
        }
      }
    },
    "review_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "path",
        "status",
        "provider_invoked"
      ],
      "properties": {
        "review_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "pending"
          ]
        },
        "provider_invoked": {
          "type": "boolean"
        }
      }
    },
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_only",
        "one_layer_at_a_time",
        "one_page_at_a_time",
        "codex_only_mutating_builder",
        "blocked_actions",
        "secret_handling",
        "next_layer_gate"
      ],
      "properties": {
        "local_only": {
          "type": "boolean",
          "const": true
        },
        "one_layer_at_a_time": {
          "type": "boolean",
          "const": true
        },
        "one_page_at_a_time": {
          "type": "boolean",
          "const": true
        },
        "codex_only_mutating_builder": {
          "type": "boolean",
          "const": true
        },
        "blocked_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "secret_handling": {
          "type": "string",
          "const": "presence_only_never_read_or_print_values"
        },
        "next_layer_gate": {
          "type": "string",
          "const": "receipt_review_and_validation_required_before_open"
        }
      }
    }
  }
}
