{
  "$schema": "ghostclaw.telegram.command_center.v2",
  "version": "2.4.0",
  "defaultExecutionMode": "preview",
  "menu": {
    "title": "SIRINX Command Center",
    "description": "Hermes control surface for status, routing, previews, and gated execution.",
