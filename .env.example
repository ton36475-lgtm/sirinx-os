# GhostClaw Environment (.env.example)
# Phase 3A: Database Connection Setup (dry-run template)

# === DATABASE ===
DATABASE_URL="mysql://sirinx:change-me@localhost:3306/sirinx"

# === API GATEWAY ===
NODE_ENV=development
API_PORT=3600
CORS_ORIGIN="http://localhost:3000"

# === KILL SWITCHES (ALL SAFE) ===
LIVE_SPEAK_ENABLED=false
EXTERNAL_SEND_ENABLED=false
ALLOW_REAL_DEPLOY=false
MCP_TOOLS_ENABLED=true
MCP_DRY_RUN=true
IMAGE_GENERATION_ENABLED=false

# === MONITORING ===
LOG_LEVEL=info
TRACE_ENABLED=true
COST_TRACKING_ENABLED=true

# === SECURITY ===
AUTH_PROFILE=ghostclaw
ALLOW_SECRET_VIEW=false

# --- GhostClaw Model Router Pack V2.1 ---
# GhostClaw model routing env example.
# Do not commit real secrets.

OpenRouterApiKey=
ProviderApprovalSigningKey=
GhostClawTelegramTrustKey=
TelegramBotToken=
TelegramHomeChannel=
TelegramChatId=
HermesAllowFable5ProviderCall=0
Fable5QuotaUrl=

# Legacy aliases remain readable during migration but new config must use the
# UpperCamelCase names above.
# OPENROUTER_API_KEY=
# PROVIDER_APPROVAL_SIGNING_KEY=
# GHOSTCLAW_TELEGRAM_TRUST_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_CHAT_ID=

# === MAXPLUS AI - DeepSeek V4 Pro Free Tier ===
MaxPlusApiKey=

# Multiple API keys for pooling
MaxPlusApiKey1=
MaxPlusApiKey2=

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.maxplus-ai.cc/v1
OPENWIKI_PROVIDER=openai-compatible
OPENWIKI_MODEL_ID=maxplus-free/deepseek-v4-pro

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# === Firecrawl (Web Scraping for RAG) ===
FIRECRAWL_API_KEY=your_api_key_here  # Get from https://firecrawl.dev
FIRECRAWL_DRY_RUN=true  # Set false only after approval
OLLAMA_API_KEY=ollama
LOCAL_QWEN_MODEL=qwen3-coder
CUSTOM_LLM_GATEWAY_BASE_URL=
CUSTOM_LLM_GATEWAY_API_KEY=
LITELLM_MASTER_KEY=
GHOSTCLAW_MODEL_ROUTER_MODE=local_safe_receipt_gated
GHOSTCLAW_DISABLE_PUSH=1
GHOSTCLAW_DISABLE_DEPLOY=1
GHOSTCLAW_DISABLE_SECRET_READ=1
