# Local-only defaults. Do not put real secrets in this file.
NODE_ENV=development

# Developer Command Center
DEV_DASHBOARD_HOST=127.0.0.1
DEV_DASHBOARD_PORT=8710
DEV_CONTROL_API_ORIGIN=http://localhost:8711

# Control API
DEV_CONTROL_API_HOST=127.0.0.1
DEV_CONTROL_API_PORT=8711
SIRINX_DRY_RUN_ONLY=true
SIRINX_REQUIRE_HUMAN_APPROVAL=true

# OpenRouter Qwen Adapter policy only. Do not put API keys in this file.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=qwen/qwen3.7-max
OPENROUTER_MODEL_FALLBACK=qwen/qwen3-max

# Solar Intelligence
SOLAR_INTEL_HOST=127.0.0.1
SOLAR_INTEL_PORT=8720

# Public sirinx.co local site
SIRINX_SITE_HOST=127.0.0.1
SIRINX_SITE_PORT=8730

# Disabled by default
CLOUDFLARE_MUTATION_ENABLED=false
CUSTOMER_MESSAGE_SEND_ENABLED=false
PAID_API_CALLS_ENABLED=false
PUBLIC_AI_EXPOSURE_ENABLED=false
DESTRUCTIVE_MCP_TOOLS_ENABLED=false
