# GhostClaw Environment (.env.example)
# Phase 3A: Database Connection Setup (dry-run template)

# === DATABASE ===
DATABASE_URL="mysql://sirinx:change-me@localhost:3306/sirinx"

# === API GATEWAY ===
NODE_ENV=development
API_PORT=3600
CORS_ORIGIN="http://localhost:3000"

# === KILL SWITCHES (ALL SAFE) ===
LIVE_SPEAK_ENABLED=false
EXTERNAL_SEND_ENABLED=false
ALLOW_REAL_DEPLOY=false
MCP_TOOLS_ENABLED=true
MCP_DRY_RUN=true
IMAGE_GENERATION_ENABLED=false

# === MONITORING ===
LOG_LEVEL=info
TRACE_ENABLED=true
COST_TRACKING_ENABLED=true

# === SECURITY ===
AUTH_PROFILE=ghostclaw
ALLOW_SECRET_VIEW=false

# --- GhostClaw Model Router Pack V2.1 ---
# GhostClaw model routing env example.
# Do not commit real secrets.

OPENROUTER_API_KEY=
HERMES_ALLOW_FABLE5_PROVIDER_CALL=0
FABLE5_QUOTA_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
LOCAL_QWEN_MODEL=qwen3-coder
CUSTOM_LLM_GATEWAY_BASE_URL=
CUSTOM_LLM_GATEWAY_API_KEY=
LITELLM_MASTER_KEY=
GHOSTCLAW_MODEL_ROUTER_MODE=local_safe_receipt_gated
GHOSTCLAW_DISABLE_PUSH=1
GHOSTCLAW_DISABLE_DEPLOY=1
GHOSTCLAW_DISABLE_SECRET_READ=1
