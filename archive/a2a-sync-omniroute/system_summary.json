  "architecture": {
    "flow": [
      "Agent A (Maker) creates session → Kimi CLI",
      "Cmux manages session isolation",
      "OmniRoute broadcasts A2A event: SESSION_READY",
      "Agent B (Checker) receives via OmniRoute",
      "Cmux switches context to Agent B",
      "State persisted to PostgreSQL for audit/recovery"
    ],
    
    "components": {
      "omniroute_client": "WebSocket + REST client for A2A messaging (port 20128)",
      "sync_protocol": "WebSocket + REST hybrid for A2A state sync",
      "state_layer": "PostgreSQL-backed event log (SQLite for testing)",
      "cmux": "Computer-use multiplexer for concurrent sessions"
    }
  },
  
