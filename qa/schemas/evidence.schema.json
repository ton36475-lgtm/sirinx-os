{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/qa/schemas/evidence.schema.json",
  "title": "SIRINX QA Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "run_id",
    "source",
    "observed_at",
    "observer",
    "environment",
    "build_identity",
    "sha256",
    "state",
    "redaction"
  ],
  "anyOf": [
    {"required": ["requirement_ids"]},
    {"required": ["finding_ids"]}
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^FND-[0-9]{3,}$"},
      "uniqueItems": true
    },
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "observer": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "build_identity": {
      "enum": ["VERIFIED", "UNVERIFIED", "NOT_AVAILABLE"]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED", "NOT_RUN"]
    },
    "redaction": {
      "enum": ["NOT_REQUIRED", "APPLIED", "REQUIRED_NOT_APPLIED"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
