{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GHOSTCLAW_POLICY_MODE": "safe_local_layered",
    "GHOSTCLAW_EXPECTED_PROVIDER": "maxplus",
    "GHOSTCLAW_EXPECTED_MODEL": "glm-5.2",
    "GHOSTCLAW_EXPECTED_IDENTITY": "glm-5.2 via MaxPlus proxy; not native Claude",
    "GHOSTCLAW_EFFORT_CAP": "high",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(* deploy*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(npx *)",
      "Bash(npm install*)",
      "Bash(pnpm install*)",
      "Bash(yarn install*)",
      "Bash(bun install*)",
      "Bash(* migrate*)",
      "Bash(rm -rf*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/maxplus-session-guard.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ghostclaw-pretool-guard.py"
          }
        ]
      }
    ]
  }
}
