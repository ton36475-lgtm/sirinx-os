{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.co/ghostclaw/a2a2a-message-v2.0",
  "title": "A2A2A Message Protocol v2.0",
  "description": "Agent → Agent → Action message format for GHOSTCLAW Hermes Commander OS",
  "type": "object",
  "required": ["a2a2a_version", "mission_id", "correlation_id", "from", "to", "action_requested", "timestamp"],
  "properties": {
    "a2a2a_version": {
      "type": "string",
      "const": "2.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^M-\\d{4}-\\d{4}-\\d{3}$",
      "description": "Mission identifier: M-YYYY-MMDD-NNN"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^sirinx-a2a2a-[a-z0-9]{8}$"
    },
    "brainstorm_id": {
      "type": "string",
      "description": "Optional canonical brainstorm identifier for LatentMAS shadow-plane correlation."
    },
    "phase": {
      "type": "string",
      "enum": [
        "brainstorm.round1.question",
        "brainstorm.round1.answer",
        "brainstorm.round2.question",
        "brainstorm.round2.answer",
        "brainstorm.inspect_answer",
        "moa.review",
        "moa.gated_brainstorm",
        "latent.shadow_probe",
        "p0_completed",
        "p1_completed",
        "p2_completed",
        "p3_completed",
        "p4_completed",
        "p5_completed",
        "p6_completed",
        "p7_completed",
        "blocked",
        "completed"
      ],
      "description": "Optional LatentMAS/GhostClaw phase marker. Existing producers may omit it."
    },
    "terminology_policy": {
      "type": "object",
      "description": "Optional brainstorm terminology compatibility policy.",
      "properties": {
        "canonical": {
          "type": "string",
          "const": "brainstorm"
        },
        "canonical_term": {
          "type": "string",
          "const": "brainstorm"
        },
        "deprecated_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["beststorm"]
          }
        },
        "invalid_typos": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["beststrom"]
          }
        },
        "emit_only_canonical": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "latent_plane": {
      "type": "object",
      "description": "Optional non-authoritative latent-plane status. JSON control plane remains authority.",
      "properties": {
        "compatible": {
          "type": "boolean"
        },
        "fallback": {
          "type": "string",
          "enum": ["json_control_plane", "shadow_only", "disabled"]
        },
        "latent_enabled": {
          "type": "boolean"
        },
        "authority": {
          "type": "string",
          "const": "shadow"
        },
        "debug_probe_mode": {
          "type": "string",
          "enum": ["parallel_text_probe"]
        }
      }
    },
    "moa_summary": {
      "type": "object",
      "description": "Optional mixture-of-agents summary metadata.",
      "properties": {
        "consensus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aggregator_certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safety_disagreement": {
          "type": "boolean"
        }
      }
    },
    "moa_gated_brainstorm": {
      "type": "object",
      "description": "Optional gated brainstorm metadata; does not authorize action by itself.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gate_status": {
          "type": "string",
          "enum": ["pending", "passed", "blocked", "requires_human"]
        },
        "required_human_review": {
          "type": "boolean"
        },
        "action_tier_cap": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "X"]
        },
        "veto_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "from": {
      "type": "object",
      "required": ["agent", "role"],
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["hermes-commander", "opus-architect", "codex-captain", "glm-worker", "deepseek-worker", "kob-validator", "command-broker", "human-operator"]
        },
        "role": {
          "type": "string",
          "enum": ["mission-commander", "chief-architect", "build-captain", "coding-worker", "reasoning-worker", "validator", "broker", "operator"]
        }
      }
    },
    "to": {
      "type": "object",
      "required": ["agent", "role"],
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["hermes-commander", "opus-architect", "codex-captain", "glm-worker", "deepseek-worker", "kob-validator", "command-broker", "human-operator"]
        },
        "role": {
          "type": "string"
        }
      }
    },
    "action_requested": {
      "type": "string",
      "enum": [
        "design_architecture",
        "review_design",
        "build_scaffold",
        "write_module",
        "fix_bug",
        "refactor",
        "integrate_patches",
        "run_tests",
        "run_lint",
        "validate",
        "stage_commit",
        "update_brain",
        "report_status",
        "stop_mission",
        "approve_action"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "goal": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lane": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "response_expected": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "within_lane": { "type": "string" },
        "max_turns": { "type": "integer", "default": 3 }
      }
    },
    "human_approval_required": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": "integer",
      "default": 600,
      "maximum": 3600
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "ROUTED", "PROCESSING", "ACTION_PENDING", "ACTION_EXECUTING", "COMPLETED", "BLOCKED", "FAILED", "CANCELLED"]
    },
    "autonomous_approval": {
      "type": "object",
      "description": "Optional autonomous mutual approval metadata. If absent, legacy human_approval_required field remains in effect.",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["disabled", "human_required", "agent_mutual_approval", "agent_quorum_approval", "auto_block"]
        },
        "requester_agent": { "type": "string" },
        "approver_agent": { "type": "string" },
        "human_approval_required": { "type": "boolean" },
        "self_approval_allowed": { "type": "boolean" },
        "evidence_pack_required": { "type": "boolean" },
        "decision_id_required": { "type": "boolean" },
        "receipt_required": { "type": "boolean" },
        "final_tier": { "type": "string", "enum": ["A", "B", "C", "D", "X"] },
        "reason": { "type": "string" }
      }
    }
  }
}
