{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.co/schemas/ghostclaw/vibe-task-graph.schema.json",
  "title": "GHOSTCLAW Vibe Task Graph",
  "description": "Schema for parsed natural language commands into structured task graphs for the GHOSTCLAW Vibe Coding Agent (Phase 5).",
  "type": "object",
  "required": [
    "task_graph_id",
    "timestamp",
    "status",
    "original_command",
    "tasks"
  ],
  "properties": {
    "task_graph_id": {
      "type": "string",
      "description": "Unique identifier for this task graph",
      "pattern": "^vibe-[a-z0-9]+-[a-z0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the graph was created"
    },
    "requester": {
      "type": "string",
      "description": "Agent or operator that created the task graph",
      "default": "vibe-agent"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "executing",
        "completed",
        "blocked",
        "rejected",
        "failed"
      ],
      "description": "Current status of the task graph"
    },
    "original_command": {
      "type": "string",
      "description": "Original natural language command"
    },
    "normalized_command": {
      "type": "string",
      "description": "Command after terminology normalization"
    },
    "terminology_normalized": {
      "type": "boolean",
      "description": "True if deprecated aliases were normalized to canonical"
    },
    "brainstorm_id": {
      "type": ["string", "null"],
      "description": "Associated brainstorm session ID (canonical term: brainstorm)"
    },
    "context_url": {
      "type": ["string", "null"],
      "description": "Optional context URL for the task"
    },
    "tasks": {
      "type": "array",
      "description": "Ordered list of tasks to execute",
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "blocked": {
      "type": "boolean",
      "description": "True if any task is blocked"
    },
    "blocked_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of blocked patterns matched in the command"
    },
    "metadata": {
      "type": "object",
      "description": "Parser metadata",
      "properties": {
        "parser_version": {
          "type": "string"
        },
        "step_count": {
          "type": "integer"
        },
        "canonical_term": {
          "type": "string",
          "const": "brainstorm",
          "description": "Canonical terminology term. 'beststorm' is a deprecated alias. 'beststrom' is an invalid typo."
        }
      }
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "required": [
        "task_id",
        "task_type",
        "status"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique task identifier within the graph"
        },
        "task_type": {
          "type": "string",
          "enum": [
            "file_operation",
            "code_generation",
            "browser_smoke",
            "dashboard_verify",
            "test_run",
            "git_operation",
            "docs_update",
            "research",
            "policy_check",
            "setup",
            "unknown"
          ],
          "description": "Type of task to execute"
        },
        "description": {
          "type": "string",
          "description": "Human-readable task description"
        },
        "worker": {
          "type": "string",
          "enum": [
            "codex-worker",
            "browser-use-worker",
            "glm-worker",
            "deepseek-worker",
            "kob-validator",
            "manual"
          ],
          "description": "Worker assigned to execute this task"
        },
        "command": {
          "type": "string",
          "description": "Normalized command for this task"
        },
        "original_command": {
          "type": "string",
          "description": "Original command text before normalization"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Parser confidence score (0-1)"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "blocked",
            "approved",
            "executing",
            "completed",
            "failed",
            "skipped",
            "rejected",
            "manual_required"
          ],
          "description": "Current status of this task"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task IDs that must complete before this task"
        },
        "blocked_reason": {
          "type": ["string", "null"],
          "description": "Reason for blocking, if blocked"
        },
        "safe_replacement": {
          "type": ["string", "null"],
          "description": "Safe alternative action recommendation"
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "X"],
          "description": "GHOSTCLAW autonomy level for this task"
        },
        "evidence_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether this task requires evidence pack artifacts"
        },
        "approval_required": {
          "type": "boolean",
          "description": "Whether human or mutual approval is required"
        }
      }
    }
  }
}