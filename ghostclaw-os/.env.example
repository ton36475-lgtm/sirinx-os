# GHOSTCLAW OS Environment Template
# Copy to .env and fill with real values.
# NEVER commit real .env

# ─── Hermes Command Center ─────────────────────────────────
HERMES_HOST=127.0.0.1
HERMES_PORT=8787

# ─── Telegram Bot ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_ADMIN_CHAT_ID=change-me
HERMES_URL=http://127.0.0.1:8787

# ─── LLM Providers (tiered routing) ────────────────────────
# Tier 1: Sovereign local (keyless)
OLLAMA_HOST=http://localhost:11434

# Tier 2: OpenRouter free models
OPENROUTER_API_KEY=

# Tier 3a: GLM / Z.ai paid
GLM_API_KEY=

# Tier 3b: MaxPlus API (Claude Fable 5 access)
MAXPLUS_API_KEY=

# ─── Thaimart Adapter ──────────────────────────────────────
THAIMART_API_URL=https://api.thaimart.co/v1
THAIMART_API_KEY=

# ─── Safety Kill Switches ──────────────────────────────────
GIT_PUSH_ENABLED=false
DEPLOY_ENABLED=false
EXTERNAL_SEND_ENABLED=false
